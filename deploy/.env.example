# ── Общее для обоих вариантов ─────────────────────────────────────────────
# Приложение Kick — одно на всех стримеров. kick.com/settings/developer
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# debug | info | warn | error
LOG_LEVEL=info


# ── Вариант A: прямой HTTPS (docker-compose.direct.yml) ───────────────────
# Для сервера с белым IP. Caddy сам получит сертификат Let's Encrypt.
# A-запись relay.example.com -> IP сервера, БЕЗ проксирования (серое облако).
RELAY_DOMAIN=relay.example.com
ACME_EMAIL=you@example.com


# ── Вариант B: туннель Cloudflare (docker-compose.yml) ────────────────────
# Для машины без белого IP. Портов наружу не требуется.
# Токен: Cloudflare Zero Trust -> Networks -> Tunnels -> Docker
RELAY_PUBLIC_URL=https://relay.example.com
CLOUDFLARE_TUNNEL_TOKEN=
