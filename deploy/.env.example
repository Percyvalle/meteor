# Публичный адрес релея. Он прописывается в приложении Kick и в сборках
# стримеров, поэтому менять его потом больно — выбирайте сразу постоянный.
RELAY_PUBLIC_URL=https://relay.example.com

# Приложение Kick — одно на всех стримеров.
# kick.com/settings/developer
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Токен именованного туннеля из Cloudflare Zero Trust:
# one.dash.cloudflare.com -> Networks -> Tunnels -> Create a tunnel -> Docker.
# В Public Hostname туннеля укажите relay.example.com -> http://relay:8088
CLOUDFLARE_TUNNEL_TOKEN=

# debug | info | warn | error
LOG_LEVEL=info
